# ===== For Local Development (Docker) =====
# Database
DATABASE_URL=postgresql://photocopy_user:photocopy_pass@database:5432/photocopy_shop

# Backend
BACKEND_PORT=8069
NODE_ENV=development
JWT_SECRET=your-jwt-secret-change-in-production

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8069

# ===== For Production (Vercel + Neon) =====
# Copy these to your Vercel environment variables:
# DATABASE_URL - Get from Neon console (PostgreSQL connection string)
# JWT_SECRET - Generate a secure random string
# CORS_ORIGIN - Your Vercel frontend URL (e.g., https://your-app.vercel.app)
# NODE_ENV - Set to "production"

# Copy this to your frontend .env for production:
# VITE_API_URL - Your Vercel backend URL (e.g., https://your-api.vercel.app/api/photocopy)
